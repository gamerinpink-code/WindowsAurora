<Window x:Class="WindowsAurora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="AuroraVisualiser"
        Width="1280" Height="720"
        Background="#05070D"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseDoubleClick="Window_MouseDoubleClick"
        Closing="Window_Closing">

    <Grid>
        <!-- GPU/Skia Visualizer Canvas -->
        <skia:SKElement x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface" />

        <!-- Auto-Hiding Floating HUD -->
        <Border x:Name="HudBar"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,28"
                Padding="18,10"
                CornerRadius="24"
                Background="#AA0D1322"
                BorderBrush="#336EE7B7"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ModeTitleText"
                           Text="1. Northern Lights (Aurora Ribbons)"
                           Foreground="#E2E8F0"
                           FontFamily="Segoe UI Semibold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />

                <Button Content="◀ Prev" Click="PrevMode_Click" Style="{DynamicResource HudBtn}" Margin="0,0,6,0"/>
                <Button Content="Next ▶" Click="NextMode_Click" Style="{DynamicResource HudBtn}" Margin="0,0,14,0"/>
                <Button x:Name="FullscreenBtn" Content="⛶ Fullscreen (F11)" Click="Fullscreen_Click" Style="{DynamicResource HudBtn}"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="HudBtn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4434D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
